# ─── Required ──────────────────────────────────────────────────────────────────
# In production, read these from your secrets manager (e.g. AWS Secrets Manager,
# Google Secret Manager, Vault) and inject via environment variables —
# never commit real values to this file.

GOOGLE_API_KEY=

# PostgreSQL — psycopg3 driver
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/flow
TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/flow_test

# ─── Optional: override defaults in app/config.py ──────────────────────────────

# Runtime environment
# ENV=production
# LOG_LEVEL=INFO

# ─── LLM provider ────────────────────────────────────────────────────────────
# "gemini" (native, default) or "groq" (Llama/Kimi/etc via LiteLLM).
# Flip this one line to swap the whole agent pipeline between providers.
# LLM_PROVIDER=gemini

# Gemini model selection (used when LLM_PROVIDER=gemini)
# gemini-flash-lite-latest has the widest free-tier quota; gemini-3.6-flash is
# only ~20 req/day free; older 2.5 models 404 on newer keys.
# EXTRACTOR_MODEL=gemini-flash-lite-latest
# REPLIER_MODEL=gemini-flash-lite-latest
# SUMMARISER_MODEL=gemini-flash-lite-latest

# Groq (used when LLM_PROVIDER=groq — first run: pip install litellm)
# Model ids are Groq's (a "/" in the id is fine); the "groq/" prefix is added for you.
# GROQ_API_KEY=
# GROQ_EXTRACTOR_MODEL=openai/gpt-oss-120b
# GROQ_REPLIER_MODEL=openai/gpt-oss-120b

# Conversation tuning
# ACTIVE_WINDOW_HOURS=24
# STALE_PROFILE_DAYS=365
# MAX_DEFLECTIONS=2

# ─── Security / rate limits (FLOW-042) ────────────────────────────────────────
# WEBHOOK_SECRET=                       # HMAC-SHA256 signing secret for inbound webhooks
# WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
# DAILY_MODEL_CALL_BUDGET=30            # Per-candidate inbound turns/day before polite hold
# RATE_LIMIT_PER_PHONE_PER_MINUTE=20
# RATE_LIMIT_PER_IP_PER_MINUTE=60

# ─── Data retention (FLOW-043) ────────────────────────────────────────────────
# RETENTION_PROTECTED_DAYS=30           # 'protected' data class (shortest window)
# RETENTION_PERSONAL_DAYS=90            # 'personal' data class
# RETENTION_OPERATIONAL_DAYS=365        # 'operational' data class
# RETENTION_CLOSED_CONVERSATION_DAYS=180

# ─── Storage (FLOW-033) ────────────────────────────────────────────────────────
# STORAGE_BACKEND=supabase              # 'local' or 'supabase'
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_RESUME_BUCKET=resumes
# LOCAL_STORAGE_DIR=.storage
# RESUME_SIGNED_URL_TTL_SECONDS=3600

# ─── WhatsApp Cloud API (FLOW-041) ────────────────────────────────────────────
# WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
# WHATSAPP_APP_SECRET=your-meta-app-secret
# WHATSAPP_ACCESS_TOKEN=your-meta-system-user-access-token
# WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
# WHATSAPP_API_VERSION=v21.0
