# Required
GOOGLE_API_KEY=

# PostgreSQL — psycopg3 async driver
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/flow
TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/flow_test

# Optional — override defaults in app/config.py
# ENV=development
# LOG_LEVEL=INFO
# EXTRACTOR_MODEL=gemini-2.5-flash
# REPLIER_MODEL=gemini-2.5-flash
# ACTIVE_WINDOW_HOURS=24
# STALE_PROFILE_DAYS=365
# MAX_DEFLECTIONS=2
# WEBHOOK_SECRET=changeme
# RECRUITER_API_KEY=changeme
# RESUME_SIGNED_URL_TTL_SECONDS=3600
